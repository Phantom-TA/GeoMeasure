# Copy to .env to override defaults. All settings use the GEO_ prefix.

# Where uploads, the SQLite database and scratch space live
GEO_DATA_DIR=data
# Any SQLAlchemy URL; defaults to SQLite inside GEO_DATA_DIR
# GEO_DATABASE_URL=postgresql+psycopg://geo:geo@localhost/geo

# Upload and archive limits (bytes)
GEO_MAX_UPLOAD_BYTES=104857600
GEO_MAX_UNCOMPRESSED_BYTES=1073741824
GEO_MAX_ZIP_ENTRIES=1000
GEO_MAX_COMPRESSION_RATIO=200

# Background processing: "process" isolates native-code crashes; "thread" is lighter
GEO_WORKER_MODE=process
GEO_WORKERS=2
GEO_MAX_ATTEMPTS=3
# Upper bound for the "Prefer: wait=N" request header (seconds)
GEO_MAX_WAIT_SECONDS=30

# Measurement
GEO_DEFAULT_STRATEGY=auto
GEO_GEODESIC_WARN_PCT=0.5

# Logging: text or json
GEO_LOG_LEVEL=INFO
GEO_LOG_FORMAT=text
